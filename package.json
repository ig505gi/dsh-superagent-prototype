{
  "name": "dsh-superagent",
  "author": "DeepSeek Harness Team <team@dsh.dev>",
  "license": "MIT",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone repository Superagent with a management dashboard and Paseo Agent Profile execution.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./web/assets/client.js",
    "./github-watch": "./lib/sources/github.js",
    "./feishu-watch": "./lib/sources/feishu.js",
    "./gitlab-watch": "./lib/sources/gitlab.js",
    "./dingtalk-watch": "./lib/sources/dingtalk.js",
    "./paseo-watch": "./lib/sources/paseo.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "web",
    "prompts",
    "skills",
    "locale",
    "scripts",
    "examples",
    "docs",
    "README.md",
    "SETUP.md"
  ],
  "scripts": {
    "build": "tsdown && tsdown -c tsdown.web.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "start": "node lib/server/main.js"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "dependencies": {
    "@getpaseo/client": "0.15.0",
    "dingtalk-stream": "2.1.5",
    "proper-lockfile": "4.1.2",
    "zod": "4.4.3",
    "@getpaseo/protocol": "0.15.0"
  },
  "devDependencies": {
    "@types/jsdom": "28.0.3",
    "@types/node": "22.20.0",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "jsdom": "29.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "bin": {
    "superagent": "lib/server/main.js"
  }
}
