# Copy to /etc/superagent/project-a/runtime.env and /etc/superagent/project-b/runtime.env.
# Replace project-a in the paths with the instance name and restrict access to credential files.
SUPERAGENT_PASSWORD_FILE=/etc/superagent/project-a/credentials/panel-password

# Set this when the local Paseo daemon requires a password.
# PASEO_PASSWORD_FILE=/etc/superagent/project-a/credentials/paseo-password

# Enable for DingTalk Stream. Give every instance its own bot application.
# DINGTALK_CLIENT_ID_FILE=/etc/superagent/project-a/credentials/dingtalk-client-id
# DINGTALK_CLIENT_SECRET_FILE=/etc/superagent/project-a/credentials/dingtalk-client-secret

# For inline credentials, replace each enabled *_FILE entry with the corresponding variable.
