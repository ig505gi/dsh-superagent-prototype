[Unit]
Description=Superagent (%i)

[Service]
Type=simple
WorkingDirectory=%h/.local/share/superagent/app
StateDirectory=superagent/%i
StateDirectoryMode=0700
UMask=0077
Environment="GLAB_CONFIG_DIR=%S/superagent/%i/glab"
Environment="GH_CONFIG_DIR=%S/superagent/%i/gh"
EnvironmentFile=%h/.config/superagent/%i.env
ExecStart=/usr/bin/env node %h/.local/share/superagent/app/lib/server/main.js --config %h/.config/superagent/%i.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s

[Install]
WantedBy=default.target
